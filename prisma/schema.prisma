// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  password     String
  role         UserRole
  permissions  Json
  avatar       String?
  logs         Log[]
  settlements  Settlement[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  isBatch         Boolean        @default(false)
  tagId           String?        @unique
  quantity        Int?
  livestockTypeId String
  breed           String?
  weight          Float
  age             Int
  status          LivestockStatus @default(Available)
  cost            Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  barnId          String
  barn            Barn           @relation(fields: [barnId], references: [id])
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  
  purchaseId      String?        @unique
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  saleId          String?        @unique
  sale            Sale?          

  vowId           String?        @unique
  vow             Vow?
}

model Purchase {
  id              String    @id @default(cuid())
  supplier        String?
  purchaseDate    DateTime
  totalCost       Float
  amountPaid      Float
  remainingAmount Float
  status          PurchaseStatus @default(Draft)
  livestockData   Json // Store draft livestock details
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  livestockId     String?   @unique
  livestock       Livestock?

  payments        Payment[]
}

model Sale {
  id              String      @id @default(cuid())
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  status          SaleStatus  @default(Draft)
  pricePerKg      Float
  initialWeight   Float?
  finalWeight     Float?
  totalPrice      Float
  amountPaid      Float
  remainingAmount Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  livestockId     String      @unique
  livestock       Livestock   @relation(fields: [livestockId], references: [id])
  payments        Payment[]
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Float
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  payments    Payment[]
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Float     @default(0)
  icon      String    @default("wallet") // 'wallet' or 'cash'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

model Settlement {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  settledById String
  settledBy   User     @relation(fields: [settledById], references: [id])
  amount      Float
  details     Json // { walletName: string, balance: number }[]
}

model Log {
  id         String     @id @default(cuid())
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  action     LogAction
  entityType EntityType
  entityId   String
  details    String
  createdAt  DateTime   @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  amount         Float
  date           DateTime
  type           PaymentType
  description    String
  walletId       String
  expenseId      String?
  saleId         String?
  contributionId String?
  purchaseId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  wallet         Wallet        @relation(fields: [walletId], references: [id])
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}


enum UserRole {
  DEVELOPER
  ADMIN
  MANAGER
  STAFF
}

enum LivestockStatus {
  Available
  Sold
  Vowed
  PendingSale // For deferred sales that are confirmed but not settled
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

enum SaleStatus {
  Draft
  Pending // For deferred sales waiting for settlement
  Completed
  Cancelled
}

enum SaleType {
  Immediate
  Deferred
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}

enum PaymentType {
  Income
  Expense
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK_TYPE
  LIVESTOCK
  PURCHASE
  PURCHASE_DRAFT
  SALE
  SALE_DRAFT
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
  SETTLEMENT
}
