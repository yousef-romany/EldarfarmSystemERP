
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  role        UserRole
  permissions Json?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

// Model for logging user actions
model Log {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     LogAction
  entityType String
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}


model Barn {
  id               String      @id @default(cuid())
  name             String
  capacity         Int
  currentOccupancy Int
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id                String        @id @default(cuid())
  tagId             String?       @unique
  isBatch           Boolean       @default(false)
  quantity          Int?
  livestockType     LivestockType @relation(fields: [livestockTypeId], references: [id])
  livestockTypeId   String
  breed             String?
  weight            Decimal       @db.Decimal(10, 2)
  age               Int?
  barn              Barn          @relation(fields: [barnId], references: [id])
  barnId            String
  status            LivestockStatus
  cost              Decimal       @default(0) @db.Decimal(12, 2)
  purchase          Purchase?
  vow               Vow?
  sales             Sale[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  PendingSale
}

model Purchase {
  id              String   @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  livestockId     String   @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal  @db.Decimal(12, 2)
  amountPaid      Decimal  @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  status          PurchaseStatus @default(Draft)
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

model Vow {
  id          String   @id @default(cuid())
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  livestockId String   @unique
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id              String   @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  pricePerKg      Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  amountPaid      Decimal  @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  initialWeight   Decimal? @db.Decimal(10, 2)
  finalWeight     Decimal? @db.Decimal(10, 2)
  status          SaleStatus @default(Draft)
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Draft
  Pending // For deferred sales waiting for settlement
  Completed
  Cancelled
}


model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal        @db.Decimal(12, 2)
  description String
  payments    Payment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}


model Contribution {
  id           String    @id @default(cuid())
  donorName    String
  description  String
  date         DateTime
  totalAmount  Decimal   @db.Decimal(12, 2)
  payments     Payment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @db.Decimal(12, 2) @default(0.00)
  icon      String    @default("wallet") // 'wallet' or 'cash'
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  walletId       String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime
  type           PaymentType
  description    String
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseId     String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleId         String?
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId      String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  contributionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PaymentType {
  Income
  Expense
}
