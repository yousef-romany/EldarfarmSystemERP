
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        UserRole @default(STAFF)
  permissions Json
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  tagId           String?        @unique
  livestockTypeId String
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  breed           String?
  weight          Decimal        @default(0)
  age             Int?
  cost            Decimal        @default(0)
  isBatch         Boolean        @default(false)
  quantity        Int?
  barnId          String
  barn            Barn           @relation(fields: [barnId], references: [id])
  status          String // Available, Sold, Quarantined, Vowed, PendingSale
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
}

model Purchase {
  id              String   @id @default(cuid())
  livestockId     String   @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal  @default(0)
  remainingAmount Decimal  @default(0)
  payments        Payment[]
  status          PurchaseStatus @default(Draft)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

model Sale {
  id              String   @id @default(cuid())
  livestockId     String   @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate, Deferred
  pricePerKg      Decimal
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  payments        Payment[]
  status          String // Draft, Pending, Completed, Cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String // Feed, Vet, Maintenance, Other
  amount      Decimal
  description String
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal
  icon      String // 'wallet' or 'cash'
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal
  date           DateTime      @default(now())
  type           String // Income, Expense
  description    String?
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([purchaseId])
  @@index([saleId])
  @@index([expenseId])
  @@index([contributionId])
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entityType String // USER, BARN, LIVESTOCK, etc.
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
}
