// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        UserRole
  permissions Json
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

enum UserRole {
  DEVELOPER
  ADMIN
  MANAGER
  STAFF
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id               String        @id @default(cuid())
  tagId            String?       @unique
  isBatch          Boolean       @default(false)
  quantity         Int?
  originalQuantity Int?
  livestockTypeId  String
  breed            String?
  weight           Decimal       @db.Decimal(10, 2)
  age              Int
  cost             Decimal       @db.Decimal(10, 2) @default(0)
  barnId           String
  status           LivestockStatus
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  livestockType    LivestockType @relation(fields: [livestockTypeId], references: [id])
  barn             Barn          @relation(fields: [barnId], references: [id])
  vow              Vow?
  purchase         Purchase?
  sale             Sale?

  @@index([livestockTypeId])
  @@index([barnId])
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  PendingSale // For deferred sales
  Culled // For animals that died or were removed
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestockId String    @unique
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal        @db.Decimal(10, 2)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payments    Payment[]
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}

model Purchase {
  id              String         @id @default(cuid())
  livestockId     String         @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal        @db.Decimal(10, 2)
  amountPaid      Decimal        @db.Decimal(10, 2)
  remainingAmount Decimal        @db.Decimal(10, 2)
  status          PurchaseStatus @default(Draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  livestock       Livestock      @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

model Sale {
  id              String      @id @default(cuid())
  livestockId     String      @unique
  customerName    String
  saleDate        DateTime
  type            SaleType
  status          SaleStatus  @default(Draft)
  pricePerKg      Decimal     @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  amountPaid      Decimal     @db.Decimal(10, 2)
  remainingAmount Decimal     @db.Decimal(10, 2)
  initialWeight   Decimal?    @db.Decimal(10, 2)
  finalWeight     Decimal?    @db.Decimal(10, 2)
  settlementDate  DateTime?
  // Fields for batch sales
  isBatchSale     Boolean     @default(false)
  quantitySold    Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedat
  livestock       Livestock   @relation(fields: [livestockId], references: [id])
  payments        Payment[]

  @@index([livestockId])
}

enum SaleType {
  Immediate // Point of Sale
  Deferred // Sale with later settlement
}

enum SaleStatus {
  Draft
  Pending // For deferred sales awaiting settlement
  Completed
  Cancelled
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @db.Decimal(10, 2)
  icon      String // cash, wallet
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(10, 2)
  date           DateTime
  type           PaymentType
  description    String
  walletId       String
  expenseId      String?
  saleId         String?
  contributionId String?
  purchaseId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  purchase       Purchase?     @relation(fields: [purchaseId], references