// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  name        String
  role        Role     @default(STAFF)
  permissions Json
  logs        Log[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id         String     @id @default(cuid())
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  action     LogAction
  entityType EntityType
  entityId   String
  details    String
  isSettlement Boolean   @default(false)
  createdAt  DateTime   @default(now())
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Livestock {
  id              String        @id @default(cuid())
  tagId           String?       @unique
  isBatch         Boolean       @default(false)
  quantity        Int?
  livestockType   LivestockType @relation(fields: [livestockTypeId], references: [id])
  livestockTypeId String
  breed           String
  weight          Decimal // For batches, could be average
  age             Int // in months
  status          LivestockStatus @default(Available)
  barn            Barn          @relation(fields: [barnId], references: [id])
  barnId          String
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String    @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Sale {
  id              String     @id @default(cuid())
  livestock       Livestock  @relation(fields: [livestockId], references: [id])
  livestockId     String     @unique
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  status          SaleStatus @default(Pending)
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  donorName   String
  receiptId   String    @unique
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String        @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Decimal
  notes       String?
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String?
  balance   Decimal
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  walletId       String
  amount         Decimal
  date           DateTime
  type           PaymentType
  description    String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId     String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  saleId         String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  expenseId      String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  contributionId String?
  createdAt      DateTime      @default(now())
}


enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum LivestockStatus {
  Available
  Quarantined
  Vowed
  PendingSale
  Sold
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum PaymentType {
  Income
  Expense
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Utilities
  Salaries
  Other
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTLEMENT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK_TYPE
  LIVESTOCK
  PURCHASE
  SALE
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
  SESSION
}
