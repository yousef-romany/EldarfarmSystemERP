// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  password    String
  name        String
  role        Role
  permissions Json
  logs        Log[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Livestock {
  id              String         @id @default(cuid())
  tagId           String?        @unique
  isBatch         Boolean        @default(false)
  quantity        Int?
  livestockTypeId String
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  breed           String
  weight          Decimal // For batches, can be average weight
  age             Int // in months
  status          LivestockStatus
  barnId          String
  barn            Barn           @relation(fields: [barnId], references: [id])
  purchaseId      String?        @unique
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id])
  sale            Sale[]
  vow             Vow?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock?
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Sale {
  id              String     @id @default(cuid())
  livestockId     String
  livestock       Livestock  @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  pricePerKg      Decimal
  totalPrice      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  amountPaid      Decimal
  remainingAmount Decimal
  status          SaleStatus
  notes           String?
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String    @unique
  date        DateTime
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String        @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal
  description String
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal
  icon      String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  amount         Decimal
  date           DateTime
  type           PaymentType
  description    String?
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
}


model Log {
  id         String     @id @default(cuid())
  timestamp  DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  action     LogAction
  entityType EntityType
  entityId   String
  details    String
  isSettlement Boolean   @default(false)
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  PendingSale // For deferred sales
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending // Deferred sale, not settled
  Completed
  Cancelled
}

enum PaymentType {
  Income
  Expense
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTLEMENT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK
  LIVESTOCK_TYPE
  PURCHASE
  SALE
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
  PAYMENT
}
