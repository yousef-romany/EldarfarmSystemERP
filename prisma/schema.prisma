// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  role        String // e.g., ADMIN, MANAGER, STAFF
  permissions String // Storing as a JSON string
  avatar      String?
  logs        Log[]
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String      @id @default(cuid())
  tagId           String?     @unique
  isBatch         Boolean     @default(false)
  quantity        Int?
  livestockTypeId String
  livestockType   LivestockType @relation(fields: [livestockTypeId], references: [id])
  breed           String
  weight          Decimal
  age             Int
  cost            Decimal?
  status          String // Available, Sold, Quarantined, Vowed, PendingSale
  barnId          String
  barn            Barn        @relation(fields: [barnId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  purchase        Purchase?
  vow             Vow?
  sales           Sale[]
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String    // Immediate, Deferred
  status          String    // Pending, Completed
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Vow {
  id          String   @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestockId String   @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  notes       String?
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // Feed, Vet, Maintenance, Other
  amount      Decimal
  description String
  payments    Payment[]
}

model Wallet {
  id      String    @id @default(cuid())
  name    String    @unique
  balance Decimal   @default(0)
  icon    String?
  payments Payment[]
}

model Payment {
  id              String    @id @default(cuid())
  walletId        String
  wallet          Wallet    @relation(fields: [walletId], references: [id])
  amount          Decimal
  date            DateTime
  type            String    // Income, Expense
  description     String?
  purchaseId      String?
  purchase        Purchase? @relation(fields: [purchaseId], references: [id])
  saleId          String?
  sale            Sale?     @relation(fields: [saleId], references: [id])
  expenseId       String?
  expense         Expense?  @relation(fields: [expenseId], references: [id])
  contributionId  String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
}

model Log {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // e.g., CREATE, UPDATE, DELETE
  entityType String // e.g., USER, BARN, LIVESTOCK
  entityId   String
  details    String
}
