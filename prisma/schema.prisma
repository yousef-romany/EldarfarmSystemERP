// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String // e.g., ADMIN, MANAGER, STAFF
  permissions String   @db.Text
  avatar      String?
  logs        Log[] // Relation to Log model
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  isBatch         Boolean        @default(false)
  tagId           String?        @unique
  quantity        Int?
  livestockTypeId String
  breed           String
  weight          Decimal        @db.Decimal(10, 2)
  age             Int
  status          String // e.g., Available, Sold, Quarantined, Vowed, PendingSale
  cost            Decimal?       @db.Decimal(10, 2)
  barnId          String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  barn            Barn           @relation(fields: [barnId], references: [id])
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal   @db.Decimal(10, 2)
  amountPaid      Decimal   @db.Decimal(10, 2)
  remainingAmount Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate or Deferred
  status          String // Pending or Completed
  pricePerKg      Decimal   @db.Decimal(10, 2)
  initialWeight   Decimal?  @db.Decimal(10, 2)
  finalWeight     Decimal?  @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  amountPaid      Decimal   @db.Decimal(10, 2)
  remainingAmount Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  payments        Payment[]
}

model Vow {
  id          String   @id @default(cuid())
  livestockId String   @unique
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String    @db.Text
  date        DateTime
  totalAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  payments    Payment[]
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String // Feed, Vet, Maintenance, Other
  amount      Decimal  @db.Decimal(10, 2)
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  payments    Payment[]
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @default(0.00) @db.Decimal(12, 2)
  icon      String    // e.g., 'cash', 'bank', 'vodafone_cash'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  payments  Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  walletId        String
  amount          Decimal       @db.Decimal(10, 2)
  date            DateTime
  type            String        // Income or Expense
  description     String?       @db.Text
  
  purchaseId      String?
  saleId          String?
  expenseId       String?
  contributionId  String?
  
  wallet          Wallet        @relation(fields: [walletId], references: [id])
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  contribution    Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([saleId])
  @@index([expenseId])
  @@index([contributionId])
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  action     String // e.g., CREATE, UPDATE, DELETE
  entityType String // e.g., BARN, LIVESTOCK, SALE
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}
