// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  name        String
  role        Role
  avatarUrl   String?
  permissions Json? // Storing detailed permissions as a JSON object
  logs        Log[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Livestock {
  id          String         @id @default(cuid())
  tagId       String?        @unique
  type        LivestockType  @relation(fields: [typeId], references: [id])
  typeId      String
  breed       String?
  weight      Float // in kg
  age         Int // in months
  status      LivestockStatus
  isBatch     Boolean        @default(false)
  quantity    Int?
  notes       String?
  barn        Barn           @relation(fields: [barnId], references: [id])
  barnId      String
  purchase    Purchase?      @relation(fields: [purchaseId], references: [id])
  purchaseId  String?
  sale        Sale[]
  vow         Vow?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Purchase {
  id           String      @id @default(cuid())
  purchaseDate DateTime
  supplier     String?
  totalCost    Decimal
  notes        String?
  livestock    Livestock[]
  payments     Payment[]
  logs         Log[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Sale {
  id              String      @id @default(cuid())
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  pricePerKg      Decimal
  initialWeight   Float?
  finalWeight     Float?
  totalPrice      Decimal
  status          SaleStatus
  notes           String?
  livestock       Livestock   @relation(fields: [livestockId], references: [id])
  livestockId     String      @unique
  payments        Payment[]
  logs            Log[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Decimal
  payments    Payment[]
  logs        Log[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String    @unique
  date        DateTime
  notes       String?
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  logs        Log[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  logs        Log[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal
  icon      String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal
  date           DateTime
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  walletId       String
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId     String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  saleId         String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  expenseId      String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  contributionId String?
  createdAt      DateTime      @default(now())
}

model Log {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  action      String // e.g., 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', 'LOGOUT'
  entity      String // e.g., 'Sale', 'Livestock', 'User'
  entityId    String?
  details     Json // Store details of the change as a JSON object
  isSettlement Boolean  @default(false)
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  purchaseId  String?
  sale        Sale?     @relation(fields: [saleId], references: [id])
  saleId      String?
  expense     Expense?  @relation(fields: [expenseId], references: [id])
  expenseId   String?
  vow         Vow?      @relation(fields: [vowId], references: [id])
  vowId       String?
  contribution Contribution? @relation(fields: [contributionId], references: [id])
  contributionId String?
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum LivestockStatus {
  AVAILABLE
  SOLD
  QUARANTINED
  VOWED
  DIED
}

enum SaleType {
  IMMEDIATE
  DEFERRED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  FEED
  VET
  MAINTENANCE
  SALARIES
  OTHER
}
