
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String
  permissions String   @db.Text
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id               String        @id @default(cuid())
  isBatch          Boolean       @default(false)
  tagId            String?       @unique
  quantity         Int?
  livestockTypeId  String
  livestockType    LivestockType @relation(fields: [livestockTypeId], references: [id])
  breed            String
  weight           Decimal
  age              Int
  barnId           String
  barn             Barn          @relation(fields: [barnId], references: [id])
  status           String        // Available, Sold, Quarantined, Vowed, PendingSale
  cost             Decimal?
  purchase         Purchase?
  sales            Sale[]
  vow              Vow?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String    // Immediate, Deferred
  status          String    // Pending, Completed
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?   @db.Text
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String    // Feed, Vet, Maintenance, Other
  description String
  amount      Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @default(0)
  icon      String    // e.g., 'cash', 'bank'
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  amount         Decimal
  date           DateTime
  type           String        // Income, Expense
  description    String?
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // CREATE, UPDATE, DELETE, LOGIN
  entityType String   // USER, BARN, LIVESTOCK, etc.
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
}
