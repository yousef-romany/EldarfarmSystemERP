
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ==================================
//          ENUMS
// ==================================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  SETTLEMENT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK_TYPE
  LIVESTOCK
  PURCHASE
  SALE
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
  PAYMENT
  LOG
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  PendingSale // For deferred sales
  Deceased
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending // For deferred sales waiting for final weight/payment
  Completed
  Cancelled
}

enum PaymentType {
  Income
  Expense
}

// ==================================
//          MODELS
// ==================================

model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  name        String
  role        Role   @default(STAFF)
  permissions Json?

  logs Log[]
}

model Log {
  id         String     @id @default(cuid())
  timestamp  DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  action     LogAction
  entityType EntityType
  entityId   String
  details    String
  isSettled  Boolean    @default(false)
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String          @id @default(cuid())
  isBatch         Boolean         @default(false)
  tagId           String?         @unique // Optional, especially for batches
  quantity        Int? // For batches
  livestockTypeId String
  livestockType   LivestockType   @relation(fields: [livestockTypeId], references: [id])
  breed           String
  weight          Decimal // For batches, can be average weight
  age             Int // in months
  status          LivestockStatus @default(Available)
  barnId          String
  barn            Barn            @relation(fields: [barnId], references: [id])
  purchaseId      String?         @unique
  purchase        Purchase?       @relation(fields: [purchaseId], references: [id])
  sales           Sale[]
  vow             Vow?
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]
}

model Sale {
  id              String     @id @default(cuid())
  livestockId     String
  livestock       Livestock  @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  status          SaleStatus @default(Completed)
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  notes       String?
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id])
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // e.g., Feed, Vet, Maintenance, Other
  description String
  totalAmount Decimal
  payments    Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  date           DateTime
  amount         Decimal
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  type           PaymentType
  description    String
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
}

model Wallet {
  id       String    @id @default(cuid())
  name     String    @unique
  balance  Decimal   @default(0)
  icon     String?
  payments Payment[]
}
