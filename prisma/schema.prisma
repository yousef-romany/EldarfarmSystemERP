// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  name        String
  email       String?
  role        String // Changed from Role enum
  permissions String // Changed from Json
  logs        Log[]
  avatar      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Log {
  id         String     @id @default(cuid())
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  timestamp  DateTime   @default(now())
  action     String // e.g., 'CREATE', 'UPDATE', 'DELETE'
  entityType String // e.g., 'BARN', 'LIVESTOCK', 'SALE'
  entityId   String
  details    String
}

model Barn {
  id               String      @id @default(cuid())
  name             String
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Livestock {
  id              String         @id @default(cuid())
  tagId           String?        @unique
  isBatch         Boolean        @default(false)
  quantity        Int?
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  livestockTypeId String
  breed           String
  weight          Decimal
  age             Int
  barn            Barn           @relation(fields: [barnId], references: [id])
  barnId          String
  status          String // "Available", "Sold", "Quarantined", "Vowed", "PendingSale"
  vow             Vow?
  purchase        Purchase?
  sales           Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String    @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String
  customerName    String
  saleDate        DateTime
  type            String // "Immediate", "Deferred"
  status          String // "Pending", "Completed"
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // "Feed", "Vet", "Maintenance", "Other"
  description String
  amount      Decimal
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id       String    @id @default(cuid())
  name     String    @unique
  balance  Decimal   @default(0)
  icon     String?
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal
  date           DateTime
  type           String // "Income" or "Expense"
  description    String?
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  walletId       String
  sale           Sale?         @relation(fields: [saleId], references: [id])
  saleId         String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId     String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  contributionId String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  expenseId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


