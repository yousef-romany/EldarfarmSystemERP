// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        Role     @default(STAFF)
  permissions Json
  avatar      String?
  logs        Log[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Livestock {
  id              String         @id @default(cuid())
  isBatch         Boolean        @default(false)
  tagId           String?        @unique
  quantity        Int?
  livestockTypeId String
  breed           String?
  weight          Decimal        @db.Decimal(10, 2)
  age             Int
  cost            Decimal        @default(0) @db.Decimal(10, 2)
  status          LivestockStatus
  barnId          String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  barn            Barn           @relation(fields: [barnId], references: [id])
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
}

model Purchase {
  id              String         @id @default(cuid())
  livestockId     String         @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal        @db.Decimal(10, 2)
  amountPaid      Decimal        @db.Decimal(10, 2)
  remainingAmount Decimal        @db.Decimal(10, 2)
  status          PurchaseStatus @default(Draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  livestock       Livestock      @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

model Sale {
  id              String       @id @default(cuid())
  livestockId     String       @unique
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  status          SaleStatus
  pricePerKg      Decimal      @db.Decimal(10, 2)
  initialWeight   Decimal?     @db.Decimal(10, 2)
  finalWeight     Decimal?     @db.Decimal(10, 2)
  totalPrice      Decimal      @db.Decimal(10, 2)
  amountPaid      Decimal      @db.Decimal(10, 2)
  remainingAmount Decimal      @db.Decimal(10, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  livestock       Livestock    @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestockId String    @unique
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String    @db.Text
  date        DateTime
  totalAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal        @db.Decimal(10, 2)
  description String         @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payments    Payment[]
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @db.Decimal(12, 2)
  icon      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal       @db-Decimal(10, 2)
  date            DateTime
  type            PaymentType
  description     String?
  walletId        String
  purchaseId      String?
  saleId          String?
  expenseId       String?
  contributionId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  wallet          Wallet        @relation(fields: [walletId], references: [id])
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  sale            Sale?         @relation(fields: [saleId], references: [id])
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  contribution    Contribution? @relation(fields: [contributionId], references: [id])

  @@index([purchaseId])
  @@index([saleId])
  @@index([expenseId])
  @@index([contributionId])
}

model Log {
  id         String     @id @default(cuid())
  userId     String
  action     LogAction
  entityType EntityType
  entityId   String
  details    String     @db.Text
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Role {
  DEVELOPER
  ADMIN
  MANAGER
  STAFF
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  PendingSale
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

enum SaleStatus {
  Draft
  Pending // For deferred sales waiting for final weight
  Completed
  Cancelled
}

enum SaleType {
  Immediate
  Deferred
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}

enum PaymentType {
  Income
  Expense
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK_TYPE
  LIVESTOCK
  PURCHASE
  PURCHASE_DRAFT
  SALE
  SALE_DRAFT
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
}
