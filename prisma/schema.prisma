// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  name        String         @unique
  password    String
  role        Role
  avatar      String?
  permissions UserPermission?
  logs        Log[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model UserPermission {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String   @unique
  overview_view     Boolean  @default(false)
  overview_add      Boolean  @default(false)
  overview_edit     Boolean  @default(false)
  overview_delete   Boolean  @default(false)
  users_view        Boolean  @default(false)
  users_add         Boolean  @default(false)
  users_edit        Boolean  @default(false)
  users_delete      Boolean  @default(false)
  barns_view        Boolean  @default(false)
  barns_add         Boolean  @default(false)
  barns_edit        Boolean  @default(false)
  barns_delete      Boolean  @default(false)
  purchases_view    Boolean  @default(false)
  purchases_add     Boolean  @default(false)
  purchases_edit    Boolean  @default(false)
  purchases_delete  Boolean  @default(false)
  sales_view        Boolean  @default(false)
  sales_add         Boolean  @default(false)
  sales_edit        Boolean  @default(false)
  sales_delete      Boolean  @default(false)
  vows_view         Boolean  @default(false)
  vows_add          Boolean  @default(false)
  vows_edit         Boolean  @default(false)
  vows_delete       Boolean  @default(false)
  contributions_view Boolean  @default(false)
  contributions_add Boolean  @default(false)
  contributions_edit Boolean  @default(false)
  contributions_delete Boolean  @default(false)
  expenses_view     Boolean  @default(false)
  expenses_add      Boolean  @default(false)
  expenses_edit     Boolean  @default(false)
  expenses_delete   Boolean  @default(false)
  wallets_view      Boolean  @default(false)
  wallets_add       Boolean  @default(false)
  wallets_edit      Boolean  @default(false)
  wallets_delete    Boolean  @default(false)
  settings_view     Boolean  @default(false)
  settings_add      Boolean  @default(false)
  settings_edit     Boolean  @default(false)
  settings_delete   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Livestock {
  id         String            @id @default(cuid())
  tagId      String?           @unique
  type       LivestockType
  breed      String
  weight     Float
  age        Int
  status     LivestockStatus
  isBatch    Boolean           @default(false)
  quantity   Int?
  barn       Barn              @relation(fields: [barnId], references: [id])
  barnId     String
  purchase   Purchase?
  vow        Vow?
  sales      Sale[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Purchase {
  id          String    @id @default(cuid())
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  date        DateTime
  totalCost   Float
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Sale {
  id              String      @id @default(cuid())
  animal          Livestock   @relation(fields: [animalId], references: [id])
  animalId        String
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  pricePerKg      Float
  totalPrice      Float
  deposit         Float?
  initialWeight   Float?
  finalWeight     Float?
  status          SaleStatus
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String    @unique
  date        DateTime
  notes       String?
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Float
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Float
  description String
  payments    Payment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Float     @default(0.0)
  icon      String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  walletId       String
  amount         Float
  date           DateTime      @default(now())
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId     String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  saleId         String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  expenseId      String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  contributionId String?
  createdAt      DateTime      @default(now())
}

model Log {
  id          String      @id @default(cuid())
  timestamp   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  action      String      // e.g., "USER_LOGIN", "CREATE_SALE", "DELETE_BARN"
  entityType  String?     // e.g., "Sale", "Barn"
  entityId    String?
  details     Json?       // To store old and new values for auditing
}

enum Role {
  Admin
  Manager
  Staff
}

enum LivestockType {
  Cow
  Sheep
  Goat
  Chicken
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}
