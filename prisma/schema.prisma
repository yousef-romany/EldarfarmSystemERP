datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  name        String
  role        Role   @default(STAFF)
  permissions Json
  logs        Log[]

  @@map("users")
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]

  @@map("barns")
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]

  @@map("livestock_types")
}

model Livestock {
  id              String        @id @default(cuid())
  tagId           String?       @unique
  isBatch         Boolean       @default(false)
  quantity        Int?
  livestockTypeId String
  livestockType   LivestockType @relation(fields: [livestockTypeId], references: [id])
  breed           String
  weight          Decimal // in kg
  age             Int // in months
  barnId          String
  barn            Barn          @relation(fields: [barnId], references: [id])
  status          String // Available, Sold, Vowed, Quarantined, PendingSale
  vow             Vow?
  purchase        Purchase?
  sales           Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("livestock")
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  notes           String?
  payments        Payment[]

  @@map("purchases")
}

model Sale {
  id              String     @id @default(cuid())
  livestockId     String
  livestock       Livestock  @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate, Deferred
  status          String // Pending, Completed, Canceled
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal    @default(0)
  remainingAmount Decimal
  notes           String?
  payments        Payment[]

  @@map("sales")
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  notes       String?

  @@map("vows")
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]

  @@map("contributions")
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // Feed, Vet, Maintenance, Other
  amount      Decimal
  description String
  notes       String?
  payments    Payment[]

  @@map("expenses")
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  type      String // Cash, Bank, E-Wallet
  balance   Decimal
  icon      String?
  payments  Payment[]

  @@map("wallets")
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal
  date           DateTime
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  type           String // Income, Expense
  description    String?
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)


  @@map("payments")
}


model Log {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, SETTLE
  entityType  String // USER, BARN, LIVESTOCK, SALE, etc.
  entityId    String
  details     String
  isSettlement Boolean @default(false)

  @@map("logs")
}


enum Role {
  ADMIN
  MANAGER
  STAFF
}
