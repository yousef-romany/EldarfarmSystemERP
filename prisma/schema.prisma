
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        Role     @default(Staff)
  permissions Json?
  logs        Log[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String // e.g., "USER_LOGIN", "CREATE_SALE", "UPDATE_LIVESTOCK", "DELETE_EXPENSE"
  entityType  String // e.g., "Sale", "Livestock", "User"
  entityId    String
  details     Json? // e.g., { "oldValues": {...}, "newValues": {...} }
  isSettlement Boolean  @default(false)
}

model Barn {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  livestock Livestock[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
  createdAt DateTime    @default(now())
}

model Livestock {
  id          String        @id @default(cuid())
  tagId       String?       @unique
  isBatch     Boolean       @default(false)
  quantity    Int?
  typeId      String
  type        LivestockType @relation(fields: [typeId], references: [id])
  breed       String?
  weight      Decimal // in kg
  age         Int // in months
  status      LivestockStatus @default(Available)
  barnId      String
  barn        Barn          @relation(fields: [barnId], references: [id])
  purchaseId  String?
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  sale        Sale?
  vow         Vow?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Purchase {
  id         String      @id @default(cuid())
  date       DateTime
  supplier   String?
  totalCost  Decimal
  notes      String?
  livestock  Livestock[]
  payments   Payment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Sale {
  id            String    @id @default(cuid())
  livestockId   String    @unique
  livestock     Livestock @relation(fields: [livestockId], references: [id])
  customerName  String
  saleDate      DateTime
  type          SaleType
  status        SaleStatus @default(Pending)
  pricePerKg    Decimal
  initialWeight Decimal
  finalWeight   Decimal?
  totalPrice    Decimal
  deposit       Decimal?
  notes         String?
  payments      Payment[]
  settlementDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Vow {
  id          String    @id @default(cuid())
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  donorName   String
  receiptId   String    @unique
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String        @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Decimal
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal
  icon      String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  walletId        String
  wallet          Wallet        @relation(fields: [walletId], references: [id])
  amount          Decimal
  date            DateTime
  purchaseId      String?
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  saleId          String?
  sale            Sale?         @relation(fields: [saleId], references: [id])
  contributionId  String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
  expenseId       String?
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  createdAt       DateTime      @default(now())
}

enum Role {
  Admin
  Manager
  Staff
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  Died
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}
