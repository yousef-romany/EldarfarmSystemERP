// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  role        String // e.g., ADMIN, MANAGER, STAFF
  permissions String @db.Text // JSON object storing user-specific permissions
  avatar      String?
  logs        Log[]
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  tagId           String?        @unique
  isBatch         Boolean        @default(false)
  quantity        Int?
  livestockTypeId String
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  breed           String
  weight          Decimal
  age             Int
  status          String // e.g., Available, Sold, Quarantined, Vowed
  cost            Decimal?
  barnId          String
  barn            Barn           @relation(fields: [barnId], references: [id])
  purchase        Purchase?
  vow             Vow?
  sales           Sale[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate or Deferred
  status          String // Pending or Completed
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?   @unique
  date        DateTime
  livestockId String    @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  notes       String?   @db.Text
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String    @db.Text
  date        DateTime
  totalAmount Decimal
  payments    Payment[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // e.g., Feed, Vet, Maintenance
  amount      Decimal
  description String    @db.Text
  payments    Payment[]
}

model Wallet {
  id      String    @id @default(cuid())
  name    String    @unique
  balance Decimal   @default(0.00)
  icon    String // To store 'cash', 'bank', etc. to render different icons
  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal
  date           DateTime
  type           String // Income or Expense
  description    String?       @db.Text
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id])
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id])
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  contributionId String?
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // e.g., CREATE, UPDATE, DELETE
  entityType String // e.g., BARN, LIVESTOCK, SALE
  entityId   String
  details    String   @db.Text
  timestamp  DateTime @default(now())
}
