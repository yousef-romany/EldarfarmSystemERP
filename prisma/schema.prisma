// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String
  avatar      String?
  permissions Json? // Using Json type for flexible permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

model Log {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String // e.g., 'CREATE', 'UPDATE', 'DELETE'
  entityType String // e.g., 'BARN', 'LIVESTOCK', 'SALE'
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
}

model Barn {
  id               String      @id @default(cuid())
  name             String
  capacity         Int
  currentOccupancy Int         @default(0)
  livestock        Livestock[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  isBatch         Boolean        @default(false)
  tagId           String?        @unique
  quantity        Int?
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  livestockTypeId String
  breed           String?
  weight          Decimal        @db.Decimal(10, 2)
  age             Int
  barn            Barn           @relation(fields: [barnId], references: [id])
  barnId          String
  status          String // e.g., 'Available', 'Sold', 'Quarantined', 'Vowed', 'PendingSale'
  cost            Decimal        @default(0) @db.Decimal(10, 2)
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Purchase {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  livestockId     String    @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal   @db.Decimal(10, 2)
  amountPaid      Decimal   @db.Decimal(10, 2)
  remainingAmount Decimal   @db.Decimal(10, 2)
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Sale {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String    @unique
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate or Deferred
  status          String // Pending or Completed
  pricePerKg      Decimal   @db.Decimal(10, 2)
  initialWeight   Decimal?  @db.Decimal(10, 2)
  finalWeight     Decimal?  @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  amountPaid      Decimal   @db.Decimal(10, 2)
  remainingAmount Decimal   @db.Decimal(10, 2)
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Vow {
    id          String    @id @default(cuid())
    donorName   String
    receiptId   String?
    date        DateTime
    livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
    livestockId String    @unique
    notes       String?   @db.Text
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model Expense {
    id          String   @id @default(cuid())
    date        DateTime
    category    String
    amount      Decimal  @db.Decimal(10, 2)
    description String
    payments    Payment[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Contribution {
    id          String   @id @default(cuid())
    donorName   String
    description String
    date        DateTime
    totalAmount Decimal  @db.Decimal(10, 2)
    payments    Payment[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Wallet {
  id        String    @id @default(cuid())
  name      String    @unique
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  icon      String // 'cash', 'bank', 'wallet'
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  wallet          Wallet        @relation(fields: [walletId], references: [id])
  walletId        String
  amount          Decimal       @db.Decimal(10, 2)
  date            DateTime
  type            String // 'Income' or 'Expense'
  description     String
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId      String?
  sale            Sale?         @relation(fields: [saleId], references: [id])
  saleId          String?
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  expenseId       String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
  contributionId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
