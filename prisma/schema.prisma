
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        Role     @default(Staff)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
}

model Barn {
  id              String      @id @default(cuid())
  name            String      @unique
  capacity        Int
  currentOccupancy Int        @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  livestock       Livestock[]
}

model LivestockType {
  id      String   @id @default(cuid())
  name    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  breeds  LivestockBreed[]
  livestock Livestock[]
}

model LivestockBreed {
  id        String    @id @default(cuid())
  name      String
  typeId    String
  type      LivestockType @relation(fields: [typeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  livestock Livestock[]

  @@unique([name, typeId])
}

model Livestock {
  id          String    @id @default(cuid())
  tagId       String?   @unique
  typeId      String
  breedId     String
  weight      Decimal   @db.Decimal(10, 2)
  age         Int
  barnId      String
  status      LivestockStatus @default(Available)
  isBatch     Boolean   @default(false)
  quantity    Int?
  notes       String?
  purchaseId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  type        LivestockType @relation(fields: [typeId], references: [id])
  breed       LivestockBreed @relation(fields: [breedId], references: [id])
  barn        Barn      @relation(fields: [barnId], references: [id])
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  sales       Sale[]
  vow         Vow?
}

model Wallet {
  id        String     @id @default(cuid())
  name      String     @unique
  balance   Decimal    @default(0) @db.Decimal(10, 2)
  icon      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  payments  Payment[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal   @db.Decimal(10, 2)
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Purchase {
  id          String      @id @default(cuid())
  date        DateTime
  totalCost   Decimal     @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  livestock   Livestock?
  payments    Payment[]
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            SaleType
  pricePerKg      Decimal   @db.Decimal(10, 2)
  initialWeight   Decimal   @db.Decimal(10, 2)
  finalWeight     Decimal?  @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  deposit         Decimal?  @db.Decimal(10, 2)
  notes           String?
  status          SaleStatus @default(Pending)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  livestock Livestock @relation(fields: [livestockId], references: [id])
  payments  Payment[]
}

model Vow {
  id          String     @id @default(cuid())
  donorName   String
  receiptId   String     @unique
  date        DateTime
  livestockId String     @unique
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  livestock Livestock @relation(fields: [livestockId], references: [id])
}

model Contribution {
  id          String    @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Payment {
  id              String      @id @default(cuid())
  amount          Decimal     @db.Decimal(10, 2)
  date            DateTime
  walletId        String
  expenseId       String?
  purchaseId      String?
  saleId          String?
  contributionId  String?
  createdAt       DateTime    @default(now())

  wallet        Wallet        @relation(fields: [walletId], references: [id])
  expense       Expense?      @relation(fields: [expenseId], references: [id])
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  contribution  Contribution? @relation(fields: [contributionId], references: [id])
}

model Log {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  userId      String
  action      LogAction
  entityType  String
  entityId    String
  details     Json?
  isSettlement Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  Admin
  Manager
  Staff
}

enum LivestockStatus {
  Available
  Sold
  Quarantined
  Vowed
  Died
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Utilities
  Salaries
  Other
}

enum SaleType {
  Immediate
  Deferred
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum LogAction {
  Create
  Update
  Delete
  Login
  Logout
  View
}
