
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

// User Authentication and Permissions
model User {
  id          String @id @default(cuid())
  username    String @unique
  password    String
  role        String // e.g., ADMIN, MANAGER, STAFF
  permissions Json   // JSON object storing user-specific permissions
  avatar      String?
  logs        Log[]
}

// Logging for user actions
model Log {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  timestamp   DateTime @default(now())
  action      String   // e.g., CREATE, UPDATE, DELETE
  entityType  String   // e.g., LIVESTOCK, SALE, BARN
  entityId    String
  details     String
}

// Core Livestock and Farm Management
model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  livestock Livestock[]
}

model Livestock {
  id              String      @id @default(cuid())
  tagId           String?     @unique
  isBatch         Boolean     @default(false)
  quantity        Int?
  livestockType   LivestockType @relation(fields: [livestockTypeId], references: [id])
  livestockTypeId String
  breed           String
  weight          Decimal // in kg
  age             Int // in months
  barn            Barn        @relation(fields: [barnId], references: [id])
  barnId          String
  status          String // Available, Sold, Quarantined, Vowed, PendingSale
  cost            Decimal? // Purchase cost or estimated value
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  purchase        Purchase?
  sale            Sale?
  vow             Vow?
}

// Financial Models
model Wallet {
  id       String    @id @default(cuid())
  name     String    @unique
  balance  Decimal   @default(0)
  icon     String?   // For UI, e.g., 'cash', 'bank', 'vodafone_cash'
  payments Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal
  wallet          Wallet        @relation(fields: [walletId], references: [id])
  walletId        String
  date            DateTime
  type            String        // Income or Expense
  description     String?
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  expenseId       String?       @unique
  sale            Sale?         @relation(fields: [saleId], references: [id])
  saleId          String?       
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  purchaseId      String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
  contributionId  String?
}

model Purchase {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String    @unique
  supplier        String?
  purchaseDate    DateTime
  totalCost       Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Sale {
  id              String    @id @default(cuid())
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String    @unique
  customerName    String
  saleDate        DateTime
  settlementDate  DateTime?
  type            String // Immediate, Deferred
  status          String // Pending, Completed
  pricePerKg      Decimal
  initialWeight   Decimal?
  finalWeight     Decimal?
  totalPrice      Decimal
  amountPaid      Decimal
  remainingAmount Decimal
  payments        Payment[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // Feed, Vet, Maintenance, Other
  amount      Decimal
  description String
  payments    Payment[]
}

// Vows and Contributions
model Vow {
  id          String    @id @default(cuid())
  donorName   String
  receiptId   String?
  date        DateTime
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  livestockId String    @unique
  notes       String?
}

model Contribution {
  id           String    @id @default(cuid())
  donorName    String
  description  String
  date         DateTime
  totalAmount  Decimal
  payments     Payment[]
}
