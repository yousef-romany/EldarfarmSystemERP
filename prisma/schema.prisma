// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        UserRole
  permissions Json?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
  settlements Settlement[]
}

enum UserRole {
  DEVELOPER
  ADMIN
  MANAGER
  STAFF
}

model Barn {
  id               String      @id @default(cuid())
  name             String      @unique
  capacity         Int
  currentOccupancy Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  livestock        Livestock[]
}

model LivestockType {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  livestock Livestock[]
}

model Livestock {
  id              String         @id @default(cuid())
  isBatch         Boolean        @default(false)
  tagId           String?        @unique
  quantity        Int?
  livestockTypeId String
  livestockType   LivestockType  @relation(fields: [livestockTypeId], references: [id])
  breed           String?
  weight          Float
  age             Int
  cost            Float          @default(0) // Cost of the animal or per head for a batch
  barnId          String
  barn            Barn           @relation(fields: [barnId], references: [id])
  status          LivestockStatus @default(Available)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  purchaseId String?  @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  sales Sale[]
  vows  Vow[]
}

enum LivestockStatus {
  Available
  Sold
  Vowed
  PendingSale // For deferred sales
}

// A purchase can have one livestock record associated with it.
model Purchase {
  id              String   @id @default(cuid())
  supplier        String?
  purchaseDate    DateTime
  totalCost       Float
  amountPaid      Float
  remainingAmount Float
  status          PurchaseStatus @default(Draft)
  livestockData   Json // To store details before confirmation
  
  livestockId String? @unique
  livestock   Livestock?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PurchaseStatus {
  Draft
  Completed
  Cancelled
}

// A sale record for a transaction.
model Sale {
  id              String   @id @default(cuid())
  livestockId     String
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  customerName    String
  saleDate        DateTime
  type            SaleType
  status          SaleStatus @default(Draft)
  
  pricePerKg      Float
  initialWeight   Float?
  finalWeight     Float?
  quantitySold    Int?

  totalPrice      Float
  amountPaid      Float
  remainingAmount Float

  settlementDate DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SaleType {
  Immediate // POS sale
  Deferred // Sale with a deposit, settlement later
}

enum SaleStatus {
  Draft
  Pending // For deferred sales awaiting final settlement
  Completed
  Cancelled
}

// This model represents a vow (nadhr) for a livestock
model Vow {
  id          String   @id @default(cuid())
  donorName   String
  receiptId   String?  @unique
  date        DateTime
  notes       String?  @db.Text
  livestockId String   @unique
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Financial contribution (e.g., cash vow)
model Contribution {
  id          String   @id @default(cuid())
  donorName   String
  description String
  date        DateTime
  totalAmount Float
  
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Expense record for things like feed, vet, etc.
model Expense {
  id          String         @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Float
  description String
  
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ExpenseCategory {
  Feed
  Vet
  Maintenance
  Other
}


// Financial Wallets or Cash Registers
model Wallet {
  id        String   @id @default(cuid())
  name      String   @unique
  balance   Float    @default(0)
  icon      String   @default("wallet") // 'wallet' or 'cash'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  payments Payment[]
}

model Payment {
  id        String  @id @default(cuid())
  walletId  String
  wallet    Wallet  @relation(fields: [walletId], references: [id])
  amount    Float
  date      DateTime
  type      PaymentType
  description String

  // A payment can be linked to one of these
  purchaseId      String?
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId          String?
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  contributionId  String?
  contribution    Contribution?  @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([purchaseId])
  @@index([saleId])
  @@index([contributionId])
  @@index([expenseId])
}

enum PaymentType {
  Income
  Expense
}

model Settlement {
  id String @id @default(cuid())
  settledById String
  settledBy User @relation(fields: [settledById], references: [id])
  amount Float
  details Json // To store wallet balances at time of settlement
  createdAt DateTime @default(now())
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     LogAction
  entityType EntityType
  entityId   String
  details    String   @db.Text
  createdAt  DateTime @default(now())
  
  @@index([userId])
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum EntityType {
  USER
  BARN
  LIVESTOCK_TYPE
  LIVESTOCK
  PURCHASE
  PURCHASE_DRAFT
  SALE
  SALE_DRAFT
  VOW
  CONTRIBUTION
  EXPENSE
  WALLET
  SETTLEMENT
}
